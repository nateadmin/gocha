# app.gocha.ai — SPA at /, Laravel API under /api (certbot manages SSL listen directives).

server {
    server_name app.gocha.ai;

    root /var/www/html/gocha/public;
    index index.html index.php;

    client_max_body_size 100M;

    add_header X-Content-Type-Options "nosniff";
    charset utf-8;

    location ^~ /api {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ^~ /sanctum {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /app {
        return 301 /;
    }

    location ^~ /app/ {
        return 301 /;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /favicon.ico {
        try_files /Logo.jpeg =404;
        access_log off;
        log_not_found off;
    }
    location = /robots.txt  { access_log off; log_not_found off; }

    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/app.gocha.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.gocha.ai/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = app.gocha.ai) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    server_name app.gocha.ai;
    return 404;
}
