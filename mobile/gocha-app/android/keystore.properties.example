# Copy to android/keystore.properties (gitignored) or export as env vars.
# Generate a keystore once:
#   keytool -genkeypair -v -storetype PKCS12 -keystore gocha-upload.keystore \
#     -alias gocha-upload -keyalg RSA -keysize 2048 -validity 10000

storeFile=../gocha-upload.keystore
storePassword=REPLACE_ME
keyAlias=gocha-upload
keyPassword=REPLACE_ME

# Alternative env vars (used by build-android-release.sh):
# GOCHA_ANDROID_KEYSTORE=/absolute/path/gocha-upload.keystore
# GOCHA_ANDROID_KEYSTORE_PASSWORD=
# GOCHA_ANDROID_KEY_ALIAS=gocha-upload
# GOCHA_ANDROID_KEY_PASSWORD=
